{
  "expo": {
    "name": "FocusFlow",
    "slug": "focusflow-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "focusflow",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.focusflow.mobile"
    },
    "android": {
      "package": "com.focusflow.mobile"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
