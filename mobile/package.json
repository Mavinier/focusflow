{
  "name": "focusflow-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "scripts": {
    "start": "expo start",
    "start:device": "expo start --tunnel",
    "start:lan": "expo start --lan",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "node --import tsx --test src/utils/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "doctor": "npx expo-doctor",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:check": "drizzle-kit check --config=drizzle.config.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/datetimepicker": "9.2.1",
    "drizzle-orm": "^0.36.4",
    "expo": "~58.0.22",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.18",
    "expo-document-picker": "^58.0.4",
    "expo-file-system": "^58.0.13",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.15",
    "expo-notifications": "^58.1.7",
    "expo-router": "~58.0.29",
    "expo-sharing": "^58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~2.33.1",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "~5.11.0",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "~0.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.0",
    "drizzle-kit": "^0.27.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
